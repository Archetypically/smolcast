# Copy to .env (gitignored) and set for your machine. Task loads .env
# automatically; environment variables of the same name take precedence.
#
# WSL only: Windows-drive directories (under /mnt) that `task stage`,
# `task run` and `task install` copy smolcast.exe into. Windows cannot run
# an exe from the WSL filesystem through interop reliably, so builds are
# copied to a Windows drive.
STAGE_DIR=/mnt/<drive>/<path>/smolcast/dev
INSTALL_DIR=/mnt/<drive>/<path>/smolcast/bin
