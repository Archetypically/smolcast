// The facts behind the comparison pages in public/compare/ (decision 033;
// the move to Jsonnet is decision 043). One object per tool, each checked
// against the sources it lists on the date in `date`. scripts/compare.py
// is the renderer only: it evaluates this file and builds the pages.
// Run `task web:compare` after changing a fact here.
//
// A cell is [status, label, note, win]: status is "yes", "part", "no" or
// null (no status shown), note is a string or null, and win marks the rows
// where the tool comes out ahead (only smolcast's wins are ever bolded).

local Y = 'yes';
local P = 'part';
local N = 'no';

local KEYS = { Ctrl: 'Control', Alt: 'Alt', Space: ' ', Win: 'Meta', '.': '.', '⌥': 'Alt' };
local k(keys) = std.join('', ['<kbd class="cap" data-key="' + KEYS[x] + '">' + x + '</kbd>' for x in keys]);
local HOTKEY = k(['Ctrl', 'Alt', 'Space']);  // smolcast's default hotkey

local c(st, label, note=null, w=false) = [st, label, note, w];
local nl(note=null) = c(N, 'Not listed', note);
local win(cell) = [cell[0], cell[1], cell[2], true];
local marked(base, keys) = base + { [key]: win(base[key]) for key in keys };

// smolcast's own column, before any page marks its wins.
local US = {
  price: c(null, 'Free'),
  license: c(null, 'Open source (MIT)'),
  os: c(null, 'Windows 11'),
  account: c(null, 'None'),
  hotkey: c(null, HOTKEY),
  clip: c(Y, 'Built in', 'Text and images. Encrypted on disk'),
  snip: c(Y, 'Built in', 'Find by name or keyword. No auto-expand'),
  emoji: c(Y, 'Built in', 'Every emoji, in color'),
  files: c(Y, 'Built in', 'Through Windows Search'),
  calc: c(Y, 'Built in', 'Units too. Enter pastes'),
  links: c(Y, 'Built in', 'Keywords with {query}'),
  ext: c(N, 'No', 'Scripts and quicklinks instead'),
  ai: c(N, 'No'),
  win: c(N, 'No'),
  size: c(null, '8 MB, one .exe', 'No installer'),
  idle: c(null, '0% CPU while hidden'),
  privacy: c(null, 'No telemetry', '<a href="/privacy">One daily update check</a>, can be turned off'),
};

local ROWS = [
  ['The basics', [['price', 'Price'], ['license', 'Source'], ['os', 'Runs on'], ['account', 'Account'], ['hotkey', 'Default hotkey']]],
  ['Features', [['clip', 'Clipboard history'], ['snip', 'Snippets'], ['emoji', 'Emoji picker'], ['files', 'File search'], ['calc', 'Calculator'], ['links', 'Quicklinks'], ['ext', 'Extensions'], ['ai', 'AI'], ['win', 'Window management']]],
  ['Under the hood', [['size', 'Download'], ['idle', 'Idle'], ['privacy', 'Privacy']]],
];

// The hub table is a regrouped subset of the same rows.
local HUB_ROWS = [
  ['The basics', [['price', 'Price'], ['license', 'Source'], ['os', 'Runs on'], ['account', 'Account']]],
  ['Features', [['clip', 'Clipboard history'], ['snip', 'Snippets'], ['emoji', 'Emoji picker'], ['files', 'File search'], ['calc', 'Calculator'], ['ext', 'Extensions'], ['ai', 'AI'], ['win', 'Window management']]],
  ['Under the hood', [['size', 'Download']]],
];

