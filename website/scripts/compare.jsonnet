// One sentence per page pointing at the comparisons its reader is most
// likely weighing next, with descriptive link text (DESIGN.md, discovery).
local vs(slug, name) = '<a href="/compare/' + slug + '">smolcast vs ' + name + '</a>';
local RELATED = {
  raycast: 'On a Mac too? Tinycast is the free, open-source take on Raycast, and Alfred is the long-standing favorite: ' + vs('tinycast', 'Tinycast') + ', ' + vs('alfred', 'Alfred') + '.',
  'powertoys-command-palette': 'For plugins without the whole suite there is ' + vs('flow-launcher', 'Flow Launcher') + ', and for one search over everything, even text on screen, ' + vs('fluent-search', 'Fluent Search') + '.',
  'flow-launcher': 'Flow Launcher began as a fork of Wox, which is still going: ' + vs('wox', 'Wox') + ". Microsoft's own launcher is next door: " + vs('powertoys-command-palette', 'PowerToys Command Palette') + '.',
  tinycast: 'Tinycast borrows from Raycast, which now runs on Windows too: ' + vs('raycast', 'Raycast for Windows') + '. On the Mac, Alfred is the long-standing favorite: ' + vs('alfred', 'Alfred') + '.',
  'fluent-search': 'For files first, see ' + vs('listary', 'Listary') + "; for Everything's index in a launcher with plugins, " + vs('flow-launcher', 'Flow Launcher') + '.',
  listary: 'For one search over files, tabs and windows, see ' + vs('fluent-search', 'Fluent Search') + '; for Everything\'s index in a launcher, ' + vs('flow-launcher', 'Flow Launcher') + '.',
  wox: 'Flow Launcher began as a fork of Wox: ' + vs('flow-launcher', 'Flow Launcher') + '. Another open-source launcher for every OS: ' + vs('ueli', 'Ueli') + '.',
  alfred: 'The free, open-source Mac cousin is Tinycast, and Raycast now has a Windows app: ' + vs('tinycast', 'Tinycast') + ', ' + vs('raycast', 'Raycast for Windows') + '.',
  keypirinha: 'Two plugin launchers that still ship updates: ' + vs('flow-launcher', 'Flow Launcher') + ' and ' + vs('wox', 'Wox') + '.',
  ueli: 'Another open-source launcher for every OS: ' + vs('wox', 'Wox') + '. Raycast now runs on Windows and Mac: ' + vs('raycast', 'Raycast for Windows') + '.',
};

